# Example .env — copy to .env and fill in the real values.
# Lines starting with # are comments. Keep secrets out of git.
# Do not paste tokens into chat. Type them here and say that you added them.

# ─────────────────────────────────────────────
# Workshop v2 — local multi-agent jobs
# ─────────────────────────────────────────────
# scripted = offline demo (no key, no model). ollama = local. openai = any OpenAI-compatible API.
WORKSHOP_PROVIDER=scripted
WORKSHOP_MODE=lite
WORKSHOP_MODEL=qwen2.5:3b
# WORKSHOP_MODEL_GB=2.2          # required only for a local model name we do not know
# WORKSHOP_RAM_GB=12             # optional override of detected available RAM
# WORKSHOP_RAM_TOTAL_GB=16       # optional override of detected installed RAM
# WORKSHOP_I_ACCEPT_RISK=1       # skip the RAM refusal after you measured the machine
# LLM_API_KEY=replace-me         # required when WORKSHOP_PROVIDER=openai
# LLM_BASE_URL=http://127.0.0.1:11434

# ─────────────────────────────────────────────
# LINE RAG bot (app/) — required for the LINE webhook
# ─────────────────────────────────────────────
LINE_CHANNEL_SECRET=replace-me
LINE_CHANNEL_ACCESS_TOKEN=replace-me
LLM_BASE_URL=http://127.0.0.1:11434           # Ollama default — use 127.0.0.1, not localhost
LLM_MODEL=gemma4:e4b                          # or gemma3:4b, qwen3:4b
EMBEDDING_MODEL=bge-m3

# ─────────────────────────────────────────────
# Telegram council bot (bot/) — required only if you run `python -m bot`
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=replace-me
# TELEGRAM_ALLOWED_USERS=123456789,987654321   # optional, restricts who can use the bot
# LOG_LEVEL=INFO

# LLM provider for the council bot
#   ollama   — local, free. Requires `ollama serve` running.
#   openai   — OpenAI-compatible. Covers OpenAI, Groq, Together, OpenRouter, LM Studio.
LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:4b                # default for ollama; gemma4:e4b also fine
# LLM_API_KEY=sk-...                 # required for LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai  # example override for Groq
# LLM_TEMPERATURE=0.4
# LLM_MAX_TOKENS=1200

# ─────────────────────────────────────────────
# Optional: Discord, OpenAI key, etc.
# ─────────────────────────────────────────────
# DISCORD_BOT_TOKEN=replace-me
# OPENAI_API_KEY=replace-me
