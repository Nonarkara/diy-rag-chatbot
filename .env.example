# Example .env — copy to .env and fill in the real values.
# Lines starting with # are comments. Keep secrets out of git.
#
# Sections:
#   1. OOTBPAP scaffold defaults          (kit-level)
#   2. AI Council skill (council/)       (kit-level)
#   3. Telegram council bot (bot/)        (kit-level)
#   4. LINE RAG (legacy, kept for ref)   (kit-level)

# ─────────────────────────────────────────────
# 1. OOTBPAP scaffold defaults
# ─────────────────────────────────────────────
# Used by `bin/scaffold` when generating new projects from
# templates/{chatbot,dashboard,webpage,file-system}/.
# Each scaffolded project also writes its own .env.example inside.

# Default LLM provider + model for new scaffolded projects.
SCAFFOLD_LLM_PROVIDER=ollama
SCAFFOLD_LLM_MODEL=qwen3:4b
SCAFFOLD_LLM_BASE_URL=http://localhost:11434

# Default port for FastAPI starters (chatbot, dashboard).
SCAFFOLD_DEFAULT_PORT=8000

# Default refresh interval for the dashboard starter (seconds).
SCAFFOLD_REFRESH_SECONDS=30

# ─────────────────────────────────────────────
# 2. AI Council skill (council/)
# ─────────────────────────────────────────────
# bin/council reads these when you run the 5-stage deliberation.
COUNCIL_PROFILE=execution-lean
COUNCIL_TRIAD=ship-now
# COUNCIL_AUTO_ROUTE=true          # let council pick the model per persona
# COUNCIL_TIMEOUT=120

# ─────────────────────────────────────────────
# 3. Telegram council bot (bot/)
# ─────────────────────────────────────────────
# Required only if you run `python -m bot`.
TELEGRAM_BOT_TOKEN=replace-me
# TELEGRAM_ALLOWED_USERS=123456789,987654321   # optional, restricts who can use the bot
# LOG_LEVEL=INFO

LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=sk-...                 # only for LLM_PROVIDER=openai
# LLM_TEMPERATURE=0.4
# LLM_MAX_TOKENS=1200

# ─────────────────────────────────────────────
# 4. LINE RAG (legacy, kept for reference)
# ─────────────────────────────────────────────
# These are no longer wired into the kit (app/ was removed when
# we pivoted to OOTBPAP). They are here for users who still have
# a LINE OA and want to re-wire it. See patterns/api-integration.md.
# LINE_CHANNEL_SECRET=replace-me
# LINE_CHANNEL_ACCESS_TOKEN=replace-me
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen3:4b
# EMBEDDING_MODEL=bge-m3
