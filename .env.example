# Example .env — copy to .env and fill in the real values.
# Lines starting with # are comments. Keep secrets out of git.

# ─────────────────────────────────────────────
# LINE RAG bot (app/) — required for the LINE webhook
# ─────────────────────────────────────────────
LINE_CHANNEL_SECRET=replace-me
LINE_CHANNEL_ACCESS_TOKEN=replace-me
LLM_BASE_URL=http://localhost:11434           # Ollama default
LLM_MODEL=gemma4:e4b                          # or gemma3:4b, qwen3:4b
EMBEDDING_MODEL=bge-m3

# ─────────────────────────────────────────────
# Telegram council bot (bot/) — required only if you run `python -m bot`
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=replace-me
# TELEGRAM_ALLOWED_USERS=123456789,987654321   # optional, restricts who can use the bot
# LOG_LEVEL=INFO

# LLM provider for the council bot
#   ollama   — local, free. Requires `ollama serve` running.
#   openai   — OpenAI-compatible. Covers OpenAI, Groq, Together, OpenRouter, LM Studio.
LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:4b                # default for ollama; gemma4:e4b also fine
# LLM_API_KEY=sk-...                 # required for LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai  # example override for Groq
# LLM_TEMPERATURE=0.4
# LLM_MAX_TOKENS=1200

# ─────────────────────────────────────────────
# Optional: Discord, OpenAI key, etc.
# ─────────────────────────────────────────────
# DISCORD_BOT_TOKEN=replace-me
# OPENAI_API_KEY=replace-me
