#!/usr/bin/env bash
# bin/scaffold — create a Project folder from a template.
#
# This is the magic. It is intentionally simple: a shell script
# that copies a template folder, writes a starter knowledge folder
# (for chatbot/dashboard), and prints what the owner should do next.
#
# Usage:
#   bin/scaffold --type chatbot --name my-assistant
#   bin/scaffold --type dashboard --name my-dashboard --out ~/projects
#   bin/scaffold --list
#   bin/scaffold --help
#
# How it works:
#   1. Parse flags.
#   2. Discover available templates from templates/<type>/.
#   3. Copy templates/<type>/starter/ → <out>/<name>/
#   4. Copy templates/<type>/README.md, AGENTS.md into the project root.
#   5. For chatbot/dashboard: generate a starter knowledge/ folder
#      with HOW-WE-FILE.md and 2 example Q/A pairs.
#   6. Make bin/start executable inside the project.
#   7. Print "what to do next".

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KIT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
TEMPLATES_DIR="${KIT_ROOT}/templates"

# ---------- defaults ----------
TYPE=""
NAME=""
OUT="${SCRIPT_DIR}/.."   # default: project sibling to bin/, same as kit root
LIST=false
HELP=false
FORCE=false

# ---------- colors ----------
if [[ -t 1 ]]; then
  C_ACCENT=$'\033[38;5;208m'   # amber
  C_DIM=$'\033[38;5;245m'
  C_BOLD=$'\033[1m'
  C_RESET=$'\033[0m'
else
  C_ACCENT="" C_DIM="" C_BOLD="" C_RESET=""
fi

# ---------- usage ----------
usage() {
  cat <<EOF
Usage: bin/scaffold [flags]

Flags:
  --type TYPE        one of: chatbot | dashboard | webpage | file-system
  --name NAME        the project folder name (no path; created inside --out)
  --out DIR          parent directory for the project (default: kit root)
  --force            overwrite the target folder if it exists
  --list             list available templates and exit
  --help             this help

Examples:
  bin/scaffold --type chatbot --name my-assistant
  bin/scaffold --type dashboard --name my-dashboard
  bin/scaffold --type webpage --name my-site
  bin/scaffold --type file-system --name my-tool
  bin/scaffold --type chatbot --name my-bot --out ~/projects
  bin/scaffold --list

After scaffold:
  cd <name>
  ./bin/start         # run the project
  claude              # open an agent
EOF
}

# ---------- arg parse ----------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --type)  TYPE="$2"; shift 2 ;;
    --name)  NAME="$2"; shift 2 ;;
    --out)   OUT="$2"; shift 2 ;;
    --force) FORCE=true; shift ;;
    --list)  LIST=true; shift ;;
    --help|-h) HELP=true; shift ;;
    *)
      echo "Unknown flag: $1" >&2
      usage
      exit 1
      ;;
  esac
done

[[ "$HELP" == true ]] && { usage; exit 0; }

# ---------- list mode ----------
if [[ "$LIST" == true ]]; then
  echo
  echo "${C_BOLD}Available templates${C_RESET} (${TEMPLATES_DIR}):"
  echo
  for d in "${TEMPLATES_DIR}"/*/; do
    [[ -d "$d" ]] || continue
    t=$(basename "$d")
    desc=""
    if [[ -f "${d}README.md" ]]; then
      # First non-empty, non-heading line of README is the description.
      desc=$(awk 'NF && !/^#/ && !/^---/{print; exit}' "${d}README.md" 2>/dev/null || true)
    fi
    printf "  ${C_ACCENT}%-12s${C_RESET}  %s\n" "$t" "${desc:-—}"
  done
  echo
  exit 0
fi

# ---------- required flags ----------
if [[ -z "$TYPE" ]] || [[ -z "$NAME" ]]; then
  echo "Error: --type and --name are required." >&2
  echo "Run \`bin/scaffold --help\` or \`bin/scaffold --list\`." >&2
  exit 1
fi

# Validate name (no slashes, no spaces, no dots that would hide the folder)
if [[ "$NAME" == */* ]] || [[ "$NAME" == *" "* ]] || [[ "$NAME" == .* ]]; then
  echo "Error: --name must be a simple folder name (no slashes, no leading dot, no spaces)." >&2
  exit 1
fi

# ---------- resolve source ----------
TEMPLATE_DIR="${TEMPLATES_DIR}/${TYPE}"
if [[ ! -d "$TEMPLATE_DIR" ]]; then
  echo "Error: template '${TYPE}' not found at ${TEMPLATE_DIR}" >&2
  echo "Run \`bin/scaffold --list\` for available templates." >&2
  exit 1
fi

STARTER_DIR="${TEMPLATE_DIR}/starter"
if [[ ! -d "$STARTER_DIR" ]]; then
  echo "Error: template '${TYPE}' has no starter/ directory at ${STARTER_DIR}" >&2
  exit 1
fi

# ---------- resolve target ----------
OUT="$(cd "${OUT}" 2>/dev/null && pwd || echo "${OUT}")"
TARGET="${OUT}/${NAME}"

if [[ -e "$TARGET" ]]; then
  if [[ "$FORCE" == true ]]; then
    echo "Warning: ${TARGET} exists — removing because of --force."
    rm -rf "$TARGET"
  else
    echo "Error: ${TARGET} already exists. Use --force to overwrite." >&2
    exit 1
  fi
fi

mkdir -p "$TARGET"

# ---------- copy ----------
echo
echo "${C_BOLD}Scaffolding${C_RESET} ${C_ACCENT}${TYPE}${C_RESET} → ${TARGET}"
echo

# starter/ → target/
cp -R "$STARTER_DIR"/. "$TARGET"/

# template-level docs → target root
for f in README.md AGENTS.md; do
  if [[ -f "${TEMPLATE_DIR}/${f}" ]]; then
    cp "${TEMPLATE_DIR}/${f}" "${TARGET}/${f}"
  fi
done

# Make bin/start executable
if [[ -f "${TARGET}/bin/start" ]]; then
  chmod +x "${TARGET}/bin/start"
fi

# ---------- type-specific extras ----------
case "$TYPE" in
  chatbot)
    # Generate a starter knowledge/ folder if not already present
    if [[ ! -d "${TARGET}/knowledge" ]]; then
      mkdir -p "${TARGET}/knowledge/examples"
      cat > "${TARGET}/knowledge/HOW-WE-FILE.md" <<'EOF'
# How we file

Knowledge files are markdown. Each file is one topic.

Format:

    ## Q: <question in the user's language>

    ## A: <answer sourced only from the file body>

    ## Source: <where this info came from>

Bilingual Q/A is encouraged: the bot answers in the language of the
user's question. Keep `Q:` and `A:` lines in the SAME language.
EOF
      cat > "${TARGET}/knowledge/examples/01-greeting.md" <<'EOF'
## Q: hi
## Q: hello
## Q: สวัสดี

## A: Hello. Ask me about <topic>. I answer only from the files in this folder; if I don't know, I say so.

## Source: starter template
EOF
      cat > "${TARGET}/knowledge/examples/02-fallback.md" <<'EOF'
## Q: what is X?
## Q: explain Y

## A: I don't have that in this folder. The owner can add a file in knowledge/ using HOW-WE-FILE.md.

## Source: starter template — fallback message
EOF
    fi
    ;;
  dashboard)
    # Generate a sample CSV the dashboard can ingest
    if [[ ! -d "${TARGET}/data" ]]; then
      mkdir -p "${TARGET}/data"
      cat > "${TARGET}/data/sample.csv" <<'EOF'
date,value
2026-01-01,10
2026-01-02,12
2026-01-03,8
2026-01-04,15
2026-01-05,11
EOF
    fi
    ;;
  webpage)
    # No extras — pure static
    ;;
  file-system)
    # Generate a sample test file
    if [[ ! -f "${TARGET}/tests/__init__.py" ]]; then
      touch "${TARGET}/tests/__init__.py"
    fi
    ;;
esac

# ---------- done ----------
echo "${C_ACCENT}✓${C_RESET} Scaffolded ${TARGET}"
echo
echo "${C_BOLD}Next steps${C_RESET}:"
echo "  cd ${NAME}"
echo "  claude               # or: opencode, codex, gemini"
echo "  ./bin/start          # run the project"
echo
echo "${C_DIM}Tip: the project's AGENTS.md will guide the agent.${C_RESET}"
