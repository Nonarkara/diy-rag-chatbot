#!/usr/bin/env bash
# bin/scaffold — the magic. Create a Project folder from a template.
#
# This is the OOTBPAP (Out-of-the-Box Plug-and-Playable) entry point.
# Any agent can run it; the human owner can run it. It copies a
# starter project from templates/<type>/ into a sibling directory,
# runs type-specific extras, and prints what to do next.
#
# Usage:
#   bin/scaffold --type chatbot --name my-assistant
#   bin/scaffold --type dashboard --name my-dashboard
#   bin/scaffold --type webpage --name my-site
#   bin/scaffold --type file-system --name my-tool
#   bin/scaffold --type chatbot --name my-bot --out ~/projects
#   bin/scaffold --list
#   bin/scaffold --help
#
# Flags:
#   --type TYPE      one of: chatbot | dashboard | webpage | file-system
#   --name NAME      project folder name (no slashes, no leading dot)
#   --out DIR        parent directory (default: kit root)
#   --force          overwrite the target folder if it exists
#   --list           list available templates and exit

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KIT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
TEMPLATES_DIR="${KIT_ROOT}/templates"

TYPE=""
NAME=""
OUT="${KIT_ROOT}"
FORCE=false
LIST=false

if [[ -t 1 ]]; then
  C_ACCENT=$'\033[38;5;208m'   # amber
  C_DIM=$'\033[38;5;245m'
  C_BOLD=$'\033[1m'
  C_RESET=$'\033[0m'
else
  C_ACCENT="" C_DIM="" C_BOLD="" C_RESET=""
fi

usage() {
  cat <<EOF
Usage: bin/scaffold [flags]

Flags:
  --type TYPE      one of: chatbot | dashboard | webpage | file-system
  --name NAME      the project folder name (no path)
  --out DIR        parent directory for the project (default: kit root)
  --force          overwrite the target folder if it exists
  --list           list available templates and exit
  --help           this help

Examples:
  bin/scaffold --type chatbot --name my-assistant
  bin/scaffold --type dashboard --name my-dashboard
  bin/scaffold --type webpage --name my-site
  bin/scaffold --type file-system --name my-tool
  bin/scaffold --list
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --type)  TYPE="$2"; shift 2 ;;
    --name)  NAME="$2"; shift 2 ;;
    --out)   OUT="$2"; shift 2 ;;
    --force) FORCE=true; shift ;;
    --list)  LIST=true; shift ;;
    --help|-h) usage; exit 0 ;;
    *)
      echo "Error: unknown flag: $1" >&2
      usage
      exit 1
      ;;
  esac
done

if [[ "$LIST" == true ]]; then
  echo
  echo "${C_BOLD}Available templates${C_RESET} (${TEMPLATES_DIR}):"
  echo
  for d in "${TEMPLATES_DIR}"/*/; do
    [[ -d "$d" ]] || continue
    t=$(basename "$d")
    desc=""
    if [[ -f "${d}README.md" ]]; then
      desc=$(awk 'NF && !/^#/ && !/^---/{print; exit}' "${d}README.md" 2>/dev/null || true)
    fi
    printf "  ${C_ACCENT}%-12s${C_RESET}  %s\n" "$t" "${desc:-—}"
  done
  echo
  exit 0
fi

if [[ -z "$TYPE" ]] || [[ -z "$NAME" ]]; then
  echo "Error: --type and --name are required." >&2
  echo "Run \`bin/scaffold --help\` or \`bin/scaffold --list\`." >&2
  exit 1
fi

if [[ "$NAME" == */* ]] || [[ "$NAME" == *" "* ]] || [[ "$NAME" == .* ]]; then
  echo "Error: --name must be a simple folder name (no slashes, no leading dot, no spaces)." >&2
  exit 1
fi

TEMPLATE_DIR="${TEMPLATES_DIR}/${TYPE}"
if [[ ! -d "$TEMPLATE_DIR" ]]; then
  echo "Error: template '${TYPE}' not found at ${TEMPLATE_DIR}" >&2
  echo "Run \`bin/scaffold --list\` for available templates." >&2
  exit 1
fi

STARTER_DIR="${TEMPLATE_DIR}/starter"
if [[ ! -d "$STARTER_DIR" ]]; then
  echo "Error: template '${TYPE}' has no starter/ directory at ${STARTER_DIR}" >&2
  exit 1
fi

OUT="$(cd "${OUT}" 2>/dev/null && pwd || echo "${OUT}")"
TARGET="${OUT}/${NAME}"

if [[ -e "$TARGET" ]]; then
  if [[ "$FORCE" == true ]]; then
    echo "${C_DIM}Warning: ${TARGET} exists — removing because of --force.${C_RESET}"
    rm -rf "$TARGET"
  else
    echo "Error: ${TARGET} already exists. Use --force to overwrite." >&2
    exit 1
  fi
fi

mkdir -p "$TARGET"

echo
echo "${C_BOLD}Scaffolding${C_RESET} ${C_ACCENT}${TYPE}${C_RESET} → ${TARGET}"
echo

# Copy starter/ contents
cp -R "$STARTER_DIR"/. "$TARGET"/

# Copy template-level docs
for f in README.md AGENTS.md; do
  if [[ -f "${TEMPLATE_DIR}/${f}" ]]; then
    cp "${TEMPLATE_DIR}/${f}" "${TARGET}/${f}"
  fi
done

# Make bin/start executable
if [[ -f "${TARGET}/bin/start" ]]; then
  chmod +x "${TARGET}/bin/start"
fi

# ---------- type-specific extras ----------
case "$TYPE" in
  chatbot)
    # Generate a starter knowledge/ if not present
    if [[ ! -d "${TARGET}/knowledge" ]]; then
      mkdir -p "${TARGET}/knowledge/examples"
      cat > "${TARGET}/knowledge/HOW-WE-FILE.md" <<'EOF'
# How we file

Knowledge files are markdown. Each file is one topic.

Format:

    ## Q: <question in the user's language>

    ## A: <answer sourced only from the file body>

    ## Source: <where this info came from>

Bilingual Q/A is encouraged: the bot answers in the language of the
user's question. Keep `Q:` and `A:` lines in the SAME language.
EOF
      cat > "${TARGET}/knowledge/examples/01-greeting.md" <<'EOF'
## Q: hi
## Q: hello
## Q: สวัสดี

## A: Hello. Ask me about <your topic>. I answer only from the files in this folder; if I don't know, I say so.

## Source: starter template
EOF
      cat > "${TARGET}/knowledge/examples/02-fallback.md" <<'EOF'
## Q: what is X?
## Q: explain Y

## A: I don't have that in this folder. The owner can add a file in knowledge/ using HOW-WE-FILE.md.

## Source: starter template — fallback message
EOF
    fi
    ;;
  dashboard)
    if [[ ! -d "${TARGET}/data" ]]; then
      mkdir -p "${TARGET}/data"
      cat > "${TARGET}/data/sample.csv" <<'EOF'
date,value
2026-01-01,10
2026-01-02,12
2026-01-03,8
2026-01-04,15
2026-01-05,11
EOF
    fi
    ;;
  webpage)
    : # static — no extras
    ;;
  file-system)
    [[ -f "${TARGET}/tests/__init__.py" ]] || touch "${TARGET}/tests/__init__.py"
    ;;
esac

# ---------- done ----------
echo "${C_ACCENT}✓${C_RESET} Scaffolded ${TARGET}"
echo
echo "${C_BOLD}Next steps${C_RESET}:"
echo "  cd ${NAME}"
echo "  claude               # or: opencode, codex, gemini"
echo "  ./bin/start          # run the project"
echo
echo "${C_DIM}Tip: the project's own AGENTS.md guides the agent.${C_RESET}"
