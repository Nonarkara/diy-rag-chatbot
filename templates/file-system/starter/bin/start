#!/usr/bin/env bash
# bin/start — run the CLI tool, with auto-venv.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "$PROJECT_ROOT"

VENV="${VENV:-$PROJECT_ROOT/.venv}"

PY=""
for candidate in python3 python3.12 python3.11 python3.10; do
  if command -v "$candidate" >/dev/null 2>&1; then
    PY="$(command -v "$candidate")"
    break
  fi
done
if [[ -z "$PY" ]]; then
  echo "Error: python3 not found. Install Python 3.10+ first." >&2
  exit 1
fi

if [[ ! -d "$VENV" ]]; then
  echo "[start] creating venv at $VENV"
  "$PY" -m venv "$VENV"
fi
VPY="$VENV/bin/python"
VPIP="$VENV/bin/pip"
if [[ ! -x "$VPY" ]]; then
  echo "Error: venv was created but $VPY is missing. Delete $VENV and retry." >&2
  exit 1
fi

need_install=0
while IFS= read -r pkg; do
  mod="${pkg%%[<>=!~ ]*}"
  mod="${mod//-/_}"
  if ! "$VPY" -c "import $mod" 2>/dev/null; then
    need_install=1
    break
  fi
done < <(grep -vE '^\s*#|^\s*$' requirements.txt)

if [[ "$need_install" == "1" ]]; then
  echo "[start] installing requirements.txt into venv"
  "$VPIP" install -q -r requirements.txt
fi

exec "$VPY" "$PROJECT_ROOT/cli.py" "$@"
