#!/usr/bin/env bash
# bin/start — serve the static site locally.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "$PROJECT_ROOT"

PORT="${PORT:-8000}"
HOST="${HOST:-127.0.0.1}"
echo "[start] serving ${PROJECT_ROOT}"
echo "[start] listening on http://${HOST}:${PORT}"
echo "[start] stop with Ctrl-C"
echo
# python's http.server is fine for local preview. For deployment,
# use any static host (GitHub Pages, Netlify, Cloudflare Pages).
exec python3 -m http.server "${PORT}" --bind "${HOST}"
