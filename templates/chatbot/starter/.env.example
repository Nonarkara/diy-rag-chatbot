# Copy to .env and fill in real values.

# LLM provider — ollama is the offline default.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=...   # only for LLM_PROVIDER=openai

# Knowledge folder
KNOWLEDGE_DIR=./knowledge

# Retrieval
TOP_K=3

# Channel limits
MAX_ANSWER_CHARS=1200
