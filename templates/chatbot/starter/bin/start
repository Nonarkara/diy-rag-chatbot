#!/usr/bin/env bash
# bin/start — run the chatbot locally, with auto-venv.
#
# First run: creates .venv/ in the project root and installs
# requirements.txt into it.
# Subsequent runs: reuses .venv/, just installs any missing deps.
#
# Override VENV to point at a different venv path.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "$PROJECT_ROOT"

VENV="${VENV:-$PROJECT_ROOT/.venv}"

# Load .env if present
if [[ -f ".env" ]]; then
  set -a; source .env; set +a
elif [[ -f ".env.example" ]]; then
  echo "[start] no .env yet — using .env.example defaults (offline Ollama)"
  set -a; source .env.example; set +a
fi

# Pick a Python that ships with pip + venv
PY=""
for candidate in python3 python3.12 python3.11 python3.10; do
  if command -v "$candidate" >/dev/null 2>&1; then
    PY="$(command -v "$candidate")"
    break
  fi
done
if [[ -z "$PY" ]]; then
  echo "Error: python3 not found. Install Python 3.10+ first." >&2
  exit 1
fi

# Create venv on first run (modern macOS is externally-managed, so
# `pip install` outside a venv is rejected)
if [[ ! -d "$VENV" ]]; then
  echo "[start] creating venv at $VENV"
  "$PY" -m venv "$VENV"
fi
VPY="$VENV/bin/python"
VPIP="$VENV/bin/pip"
if [[ ! -x "$VPY" ]]; then
  echo "Error: venv was created but $VPY is missing. Delete $VENV and retry." >&2
  exit 1
fi

# Install requirements if any of the named deps are missing
need_install=0
while IFS= read -r pkg; do
  mod="${pkg%%[<>=!~ ]*}"   # strip version specifiers
  mod="${mod//-/_}"
  if ! "$VPY" -c "import $mod" 2>/dev/null; then
    need_install=1
    break
  fi
done < <(grep -vE '^\s*#|^\s*$' requirements.txt)

if [[ "$need_install" == "1" ]]; then
  echo "[start] installing requirements.txt into venv"
  "$VPIP" install -q -r requirements.txt
fi

echo "[start] knowledge dir: ${KNOWLEDGE_DIR:-./knowledge}"
echo "[start] LLM: ${LLM_PROVIDER:-ollama}:${LLM_MODEL:-qwen3:4b}"
echo "[start] listening on http://127.0.0.1:8000"
echo "[start] test: curl -X POST http://127.0.0.1:8000/ask -H 'Content-Type: application/json' -d '{\"q\":\"hi\"}'"
echo
exec "$VPY" -m uvicorn app:app --host 127.0.0.1 --port 8000 --reload
